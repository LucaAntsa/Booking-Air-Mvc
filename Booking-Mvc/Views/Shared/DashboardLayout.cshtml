@using System.Security.Claims
@{
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - BookingAir</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <header class="header-dashboard">
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <!-- LOGO DASHBOARD -->
                <a class="navbar-brand" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="adminNavbar">
                    <!-- NAVIGATION GAUCHE -->
                    <ul class="navbar-nav me-auto">
                        <!-- Ce lien renvoie vers le layout principal du site -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Back</a>
                        </li>
                        <!-- Tous les autres liens restent dans le dashboard -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">Overview</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Destinations" asp-action="Index">Destinations</a>
                        </li>
                    </ul>

                    <!-- NAVIGATION DROITE -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENT -->
    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>