<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Booking_Mvc</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Booking_Mvc.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/destination.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/billet.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body>
    <header class="header-main">
        <nav class="px-3 navbar navbar-expand-sm navbar-light header-navbar">
            <div class="container-fluid header-container">

                <!-- LOGO GAUCHE -->
                <a class="navbar-brand header-logo" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-plane header-icon"></i> BookingAir
                </a>

                <button class="navbar-toggler header-toggle" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse header-menu">
                    <!-- NAVIGATION CENTRE -->
                    <ul class="navbar-nav header-center">

                        <li class="nav-item">
                            <a class="nav-link header-link" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house header-icon"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link header-link" asp-controller="Home" asp-action="Privacy">
                                <i class="fa-solid fa-lock header-icon"></i> Privacy
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link header-link" asp-controller="Home" asp-action="Privacy">
                                <i class="fa-solid fa-lock header-icon"></i> Privacy
                            </a>
                        </li>
                        <li class="nav-item header-search-li">
                            <form class="d-flex header-search-form" role="search">
                                <input class="form-control header-search-input" type="search" placeholder="Search flights..." aria-label="Search">
                                <button class="btn header-search-btn" type="submit">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </form>
                        </li>
                    </ul>

                    <!-- DROITE -->
                    <ul class="navbar-nav header-right">

                        <li class="nav-item">
                            <a class="nav-link header-link" asp-controller="Home" asp-action="Sign">
                                <i class="fa-solid fa-user-plus header-icon"></i> Sign
                            </a>
                        </li>

                        <li class="nav-item px-3">
                            <a class="nav-link header-login" asp-controller="Home" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket header-icon"></i> Login
                            </a>
                        </li>

                    </ul>

                </div>

            </div>
        </nav>
    </header>
<br>
    <div>
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-main">

        <div class="container footer-container">

            <!-- LOGO + DESCRIPTION -->
            <div class="footer-brand">
                <h4 class="footer-logo">
                    <i class="fa-solid fa-plane footer-icon"></i> BookingAir
                </h4>
                <p class="footer-text">
                    Book flights easily and travel the world with comfort and security.
                </p>
            </div>


            <!-- NAVIGATION -->
            <div class="footer-links">

                <h5 class="footer-title">Navigation</h5>

                <a asp-controller="Home" asp-action="Index" class="footer-link">
                    <i class="fa-solid fa-house"></i> Home
                </a>

                <a asp-controller="Home" asp-action="Privacy" class="footer-link">
                    <i class="fa-solid fa-lock"></i> Privacy
                </a>

                <a asp-controller="Home" asp-action="Sign" class="footer-link">
                    <i class="fa-solid fa-user-plus"></i> Sign up
                </a>

            </div>


            <!-- SUPPORT -->
            <div class="footer-support">

                <h5 class="footer-title">Support</h5>

                <p class="footer-contact">
                    <i class="fa-solid fa-envelope"></i> support@bookingair.com
                </p>

                <p class="footer-contact">
                    <i class="fa-solid fa-phone"></i> +261 34 00 000 00
                </p>

            </div>


            <!-- SOCIAL -->
            <div class="footer-social">

                <h5 class="footer-title">Follow us</h5>

                <div class="footer-social-icons">

                    <a href="#" class="footer-social-link">
                        <i class="fa-brands fa-facebook"></i>
                    </a>

                    <a href="#" class="footer-social-link">
                        <i class="fa-brands fa-twitter"></i>
                    </a>

                    <a href="#" class="footer-social-link">
                        <i class="fa-brands fa-instagram"></i>
                    </a>

                </div>

            </div>

        </div>


        <!-- COPYRIGHT -->
        <div class="footer-bottom">
            © 2026 BookingAir - All rights reserved
        </div>

    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
