@model Booking_Mvc.Models.LoginViewModel

@{
    ViewData["Title"] = "Connexion";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-left">
            <div class="auth-brand">
                <h2><i class="fa-solid fa-plane-departure me-2"></i>BookingAir</h2>
                <span class="brand-line"></span>
            </div>

            <div class="auth-content">
                <h1>Bienvenue !</h1>
                <p class="auth-description">
                    Connectez-vous à votre compte pour gérer vos réservations,
                    consulter vos vols et profiter d’une expérience de voyage
                    simple, rapide et sécurisée.
                </p>

                <a class="btn-switch-auth" asp-controller="Account" asp-action="Register">
                    <i class="fa-solid fa-user-plus me-2"></i>Create account
                </a>

                <div class="auth-divider">
                    <span>or continue with</span>
                </div>

                <div class="social-box">
                    <a href="#" class="social-icon" aria-label="Facebook">
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a href="#" class="social-icon" aria-label="X">
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>
                    <a href="#" class="social-icon" aria-label="Instagram">
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="auth-right">
            <form asp-action="Login" method="post" class="auth-form">
                <div class="auth-form-header">
                    <h3>Sign in</h3>
                    <p>Entrez vos identifiants pour accéder à votre espace BookingAir.</p>
                </div>

                <div asp-validation-summary="All" class="text-danger text-center mb-3"></div>

                <div class="form-group-modern">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <div class="input-icon-group">
                        <i class="fa-regular fa-envelope input-icon"></i>
                        <input asp-for="Email" type="email" class="form-control modern-input" placeholder="Enter your email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group-modern">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-icon-group">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input asp-for="Password" type="password" class="form-control modern-input" placeholder="Enter your password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="auth-options">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">
                            Remember me
                        </label>
                    </div>

                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>

                <button type="submit" class="btn-login-modern">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Connect
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}