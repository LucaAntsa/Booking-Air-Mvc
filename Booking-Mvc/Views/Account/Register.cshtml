@model Booking_Mvc.Models.RegisterViewModel

@{
    ViewData["Title"] = "Inscription";
}

<div class="form-Sign register-page">
    <div class="form-disagn">
        <h2>Créez votre compte</h2>
        <p class="register-text">
            Rejoignez BookingAir pour réserver vos vols rapidement et gérer vos voyages en toute simplicité.
        </p>

        <a class="nav-link text-dark btn-sign" asp-controller="Account" asp-action="Login">Login</a>

        <p class="separator-text">or</p>

        <div class="social-box">
            <a href="#" class="social-icon"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="#" class="social-icon"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="#" class="social-icon"><i class="fa-brands fa-instagram"></i></a>
        </div>
    </div>

    <form asp-action="Register" method="post" class="form-Sign-user register-form">
        <h3 class="text-center mt-2 mb-0">Create your account</h3>
        <p class="text-center form-subtitle">
            Join BookingAir and start booking your flights easily
        </p>

        <div asp-validation-summary="All" class="text-danger text-center mb-3"></div>

        <div class="row g-3 px-3 mb-2">
            <div class="col-md-6">
                <label asp-for="Nom" class="form-label">Full name</label>
                <input asp-for="Nom" type="text" class="form-control custom-input" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email address</label>
                <input asp-for="Email" type="email" class="form-control custom-input" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="px-3 mb-2">
            <label asp-for="Adresse" class="form-label">Address</label>
            <input asp-for="Adresse" type="text" class="form-control custom-input" />
            <span asp-validation-for="Adresse" class="text-danger"></span>
        </div>

        <div class="px-3 mb-2">
            <label asp-for="Numero" class="form-label">Phone number</label>
            <input asp-for="Numero" type="text" class="form-control custom-input" />
            <span asp-validation-for="Numero" class="text-danger"></span>
        </div>

        <div class="row g-3 px-3 mb-3">
            <div class="col-md-6">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password" type="password" class="form-control custom-input" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control custom-input" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="text-center mt-3 mb-4">
            <button type="submit" class="btn-sub-create register-btn">Create account</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}