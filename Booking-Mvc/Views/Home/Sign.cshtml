@{
    ViewData["Title"] = "Sign";
}

<div class="form-Sign mx-5">
    <div class="form-disagn">
        <h2 class="form-title">Create your account</h2>
        <p class="form-text">
            Join BookingAir and book your flights easily and securely.
        </p>

        <a class="btn-sign" asp-controller="Home" asp-action="Login">
            Login
        </a>

        <p class="form-separator">or continue with</p>
        <div class="form-social">
            <a href="#" class="form-social-btn form-facebook">
                <i class="fa-brands fa-facebook-f"></i>
            </a>

            <a href="#" class="form-social-btn form-google">
                <i class="fa-brands fa-google"></i>
            </a>

            <a href="#" class="form-social-btn form-binance">
                <i class="fa-brands fa-btc"></i>
            </a>
        </div>
    </div>
    <form action="" class="form-Sign-user">
        <h3 style="text-align: center;" class="mt-2 mb-0">Create your account</h3>
        <p style="text-align: center;">Join BookingAir and start booking your flights easily</p>

        <div class="d-flex part-form mx-3 mb-2">
            <div class="flex-fill">
                <label for="">Full name</label><br>
                <input type="text">
            </div>
            <div class="flex-fill">
                <label for="">Email address</label>
                <br>
                <input type="email">
            </div>
        </div>

        <div class="part-form mx-3 mb-2" style="text-align: center;">
            <label for="">Address</label>
            <br>
            <input type="text">
        </div>

        <div class="d-flex part-form mx-3 mb-2">
            <div class="flex-fill">
                <label for="">Password</label>
                <br>
                <input type="password">
            </div>
            <div class="flex-fill">
                <label for="">Confirm password</label> <br>
                <input type="password">
            </div>
        </div>

        <div class="text-center my-2">
            <button type="submit" class="btn-sub-create">Create account</button>
        </div>
    </form>
</div>
