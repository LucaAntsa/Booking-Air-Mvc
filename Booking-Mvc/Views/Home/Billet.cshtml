@{
    ViewData["Title"] = "Reservation";
}

<section class="billet-section">
    <div class="billet-card">
        <!-- HEADER -->
        <div class="billet-header">
            <div>
                <p class="billet-label">Route</p>
                <h3 class="billet-route">Tana → Paris</h3>
            </div>

            <div class="billet-time text-end">
                <div>
                    <p class="billet-label">Duration</p>
                    <h3 class="billet-time-value">5h</h3>
                </div>
            </div>
        </div>

        <!-- INFOS -->
        <div class="billet-info pt-2" style="line-height: 0.1rem;">
            <p><span>Flight date:</span> 2 Dec 2026</p>
            <div style="line-height: normal;">
                <p class="billet-label">Departure</p>
                <h3 class="billet-time-value">08:00</h3>
            </div>
        </div>

        <!-- FORM -->
        <form class="billet-form">
            <div class="billet-form-top">
                <div>
                    <p class="billet-label">Price</p>
                    <h4 class="billet-price">$500</h4>
                </div>

                <div class="billet-qty">
                    <label>Tickets</label>
                    <input type="number" value="1" min="1">
                </div>
            </div>

            <button type="submit" class="btn-billet">
                Book now
            </button>
        </form>
    </div>
</section>