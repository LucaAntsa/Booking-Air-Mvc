@using Booking_Mvc.Enums
@model List<Booking_Mvc.Models.Destination>
@{
    ViewData["Title"] = "Destinations";
}
<link rel="stylesheet" href="/css/listBillets.css" asp-append-version="true" />

<section class="liste-filters py-4">

    <div class="container">

        <div class="liste-filters-bar d-flex flex-wrap justify-content-between align-items-center gap-3">
            <!-- Filtres -->
            <form method="get" asp-action="ListeDestination">
                <div class="liste-filters-bar d-flex flex-wrap justify-content-around align-items-center gap-3">
                    <!-- SEARCH -->
                    <div class="liste-search">
                        <input type="text"
                            name="search"
                            class="liste-search-input"
                            placeholder="Search destinations..." />

                        <button class="liste-search-btn" type="submit">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </div>
                    <!-- FILTRES -->
                    <div class="liste-selects d-flex gap-2 flex-wrap">
                       <select name="nomVol" class="liste-select">
                            <option value="">All Flights</option>
                            @foreach (NomVol v in Enum.GetValues(typeof(NomVol)))
                            {
                                <option value="@v">@v</option>
                            }
                        </select>
                        <!-- DATE DEPART -->
                        <select name="dateDepart" class="liste-select">
                            <option value="">All Dates</option>
                            @foreach (var d in Model.Select(x => x.Date_Depart.ToString("yyyy-MM-dd")).Distinct())
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                        <!-- HEURE -->
                        <select name="heureDepart" class="liste-select">
                            <option value="">Departure Time</option>
                            @foreach (var h in Model.Select(x => x.Heur_Depart).Distinct())
                            {
                                <option value="@h">@h</option>
                            }
                        </select>
                    </div>
                </div>
            </form>
        </div>
    </div>

</section>

<section class="liste-grid container mt-4">
    @* Boucle Razor pour les destinations *@
    @* Exemple fixe, à remplacer par une boucle foreach *@
    @foreach (var item in Model)
    {

    <div class="destination-card">
        <div class="destination-top">
            <div class="destination-route">
                <p class="destination-label" style="display: flex; gap: 0 2vw">Route:<span class="type-badge">
                    @item.Nom_Vol
                </span></p>
                <p class="destination-value">@item.Lieu_Depart → @item.Lieu_Arriver</p>
                
            </div>
            <div class="destination-duration">
                <i class="fa-solid fa-clock"></i>
                <span>@item.Heur_Depart / @item.Duree</span>
            </div>
        </div>

        <div class="destination-dates">
            <p><span>durée de vol:</span> @item.Heur_Depart</p>
            <p><span>Depare</span> @item.Date_Depart.ToString("dd/MM/yyyy")  <span>Arrive</span> @item.Date_Arriver.ToString("dd/MM/yyyy")</p>
        </div>

        <div class="destination-bottom">
            <p class="destination-price">$@item.Prix</p>
            <a class="destination-buy" asp-controller="Billets" asp-action="Billet" asp-route-idDestination="@item.Id">Reserver un vol</a>
        </div>
    </div>

    }
    @* Duplique les autres cartes selon les données *@
</section>