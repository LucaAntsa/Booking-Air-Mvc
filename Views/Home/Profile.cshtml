<div class="profile-page-modern">

    <!-- HEADER DU PROFIL -->
    <header class="profile-header-modern">
        <div>
            <h1 class="profile-name-modern">Nom: @User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value</h1>
            <p class="profile-username-modern">Role: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</p>
        </div>
        <button class="btn-edit-profile-modern">Edit Profile</button>
    </header>

    <!-- GRID DU PROFIL -->
    <section class="profile-grid-modern">

        <div class="profile-card-modern">
            <h3>Email</h3>
            <p>@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
        </div>

        <div class="profile-card-modern">
            <h3>Member Since</h3>
            <p>12 Jun 2022</p>
        </div>

        <div class="profile-card-modern">
            <h3>Booked Flights</h3>
            <p>24</p>
        </div>

        <div class="profile-card-modern">
            <h3>Favorite Destinations</h3>
            <p>Tana, Paris</p>
        </div>

        <div class="profile-card-modern">
            <h3>Upcoming Trips</h3>
            <p>japan</p>
        </div>

    </section>

</div>