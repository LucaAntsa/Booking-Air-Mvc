@model List<Booking_Mvc.Models.Destination>
@using System.Security.Claims
@{
    var role = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
}

@{
    ViewData["Title"] = "Accueil";
}

<div class="text-center">
    <div class="fond-acc">
        <h1 class="display-4">Welcome to BookinAir</h1>
        <p>Application de réservation de billets.</p>
    </div>
    <br />

    <div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Liste des destinations récentes :</h2>

        <a asp-controller="Home"
        asp-action="ListeDestination"
        class="btn btn-success">
            Voir toutes les destinations
        </a>
    </div>
    <section class="destination-grid">
        @* mettre boucle *@
            @foreach (var item in Model
    .OrderByDescending(x => x.Date_Depart)
    .Take(3))
            {

            <div class="destination-card">
                <div class="destination-top">
                    <div class="destination-route">
                        <p class="destination-label" style="display: flex; gap: 0 2vw">Route:<span class="type-badge">
                            @item.Nom_Vol
                        </span></p>
                        <p class="destination-value" style="text-align: left;">@item.Lieu_Depart → @item.Lieu_Arriver</p>

                    </div>
                    <div class="destination-duration">
                        <i class="fa-solid fa-clock"></i>
                        <span>@item.Heur_Depart / @item.Duree</span>
                    </div>
                </div>

                <div class="destination-dates">
                    <p><span>durée de vol:</span> @item.Heur_Depart</p>
                    <p><span>Depare</span> @item.Date_Depart.ToString("dd/MM/yyyy")  <span>Arrive</span> @item.Date_Arriver.ToString("dd/MM/yyyy")</p>
                </div>

                <div class="destination-bottom">
                    <p class="destination-price">$@item.Prix</p>
                    <a class="destination-buy" asp-controller="Billets" asp-action="Billet" asp-route-idDestination="@item.Id">Reserver un vol</a>
                </div>
            </div>

            }

    </section>

    <section class="home-about-section">
        <div class="container">
            <div class="home-about-content">
                <h2 class="home-about-title">
                    Why choose BookingAir?
                </h2>
                <p class="home-about-description">
                    BookingAir is a modern platform designed to make flight booking simple,
                    fast, and accessible to everyone. Our goal is to help travelers easily
                    find destinations, compare schedules, and book flights with the best
                    prices in just a few clicks.
                </p>
                <div class="home-about-features">
                    <div class="home-feature">
                        <i class="fa-solid fa-plane"></i>
                        <p>Multiple destinations</p>
                    </div>
                    <div class="home-feature">
                        <i class="fa-solid fa-clock"></i>
                        <p>Fast booking</p>
                    </div>
                    <div class="home-feature">
                        <i class="fa-solid fa-shield-halved"></i>
                        <p>Secure payment</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>