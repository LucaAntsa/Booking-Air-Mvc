@model Booking_Mvc.Models.DashboardViewModel
@{
Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<div class="container my-4">
<!-- HEADER -->
<div class="mb-4">
    <h3 class="fw-bold mb-1">Dashboard</h3>
    <small class="text-muted">Vue globale des utilisateurs et statistiques</small>
</div>

<!-- STATS CARDS -->
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="stat-card total">
            <div>
                <small>Total Users</small>
                <h4>@Model.TotalUsers</h4>
            </div>
            <i class="bi bi-people"></i>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card active">
            <div>
                <small>Active</small>
                <h4>@Model.ActiveUsers</h4>
            </div>
            <i class="bi bi-person-check"></i>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card inactive">
            <div>
                <small>Inactive</small>
                <h4>@Model.InactiveUsers</h4>
            </div>
            <i class="bi bi-person-x"></i>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card connected">
            <div>
                <small>Connected</small>
                <h4>@Model.ConnectedUsers</h4>
            </div>
            <i class="bi bi-wifi"></i>
        </div>
    </div>

</div>

<!-- CHART + TABLE -->
<div class="row g-4">

    <!-- CHART -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 h-100">
            <h6 class="fw-semibold mb-3">Répartition utilisateurs</h6>
            <canvas id="userChart"></canvas>
        </div>
    </div>

    <!-- TABLE -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">

            <!-- HEADER TABLE -->
            <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0">Utilisateurs</h6>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Role</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach(var user in Model.Users)
                        {
                            <tr>

                                <td class="fw-semibold">@user.Nom</td>

                                <td class="text-muted">@user.Email</td>

                                <td>
                                    <span class="badge status-badge">
                                        @user.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-secondary-subtle text-dark">
                                        @user.Role
                                    </span>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION -->
            <div class="p-3">
                <nav>
                    <ul class="pagination justify-content-end mb-0">
                        @for(int i=1; i<=Model.TotalPages; i++)
                        {
                            <li class="page-item @(i==Model.PageIndex?"active":"")">
                                <a class="page-link" asp-action="Dashboard" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>

        </div>
    </div>

</div>

</div>

<style>

/* ===== STATS CARDS ===== */
.stat-card {
    background: white;
    border-radius: 16px;
    padding: 18px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: 0.2s;
}

.stat-card:hover {
    transform: translateY(-3px);
}

.stat-card i {
    font-size: 1.8rem;
    opacity: 0.7;
}

/* colors */
.stat-card.total { border-left: 4px solid #0d6efd; }
.stat-card.active { border-left: 4px solid #198754; }
.stat-card.inactive { border-left: 4px solid #dc3545; }
.stat-card.connected { border-left: 4px solid #6f42c1; }

/* ===== STATUS ===== */
.status-badge {
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.75rem;
    background: rgba(25,135,84,0.1);
    color: #198754;
}

/* ===== TABLE HOVER ===== */
tbody tr {
    transition: 0.2s;
}

tbody tr:hover {
    background-color: #f8f9fa;
}

</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const ctx = document.getElementById('userChart').getContext('2d');

new Chart(ctx, {
    type: 'doughnut',
    data: {
        labels: ['Active', 'Inactive'],
        datasets: [{
            data: [@Model.ActiveUsers, @Model.InactiveUsers],
            backgroundColor: ['#198754', '#dee2e6'],
            borderWidth: 0
        }]
    },
    options: {
        cutout: '70%',
        plugins: {
            legend: { position: 'bottom' }
        }
    }
});
</script>
