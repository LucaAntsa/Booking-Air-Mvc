@model List<Booking_Mvc.Models.Destination>

@{
ViewData["Title"] = "Destinations";
Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold">Destinations</h3>

<a asp-action="Create" class="btn btn-primary">
    <i class="bi bi-plus-lg"></i> Nouvelle destination
</a>


</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
    <table class="table align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th>Vol</th>
                <th>Trajet</th>
                <th>Horaires</th>
                <th>Durée</th>
                <th>Prix</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr class="border-top">

                    <!-- NOM VOL -->
                    <td class="fw-semibold text-primary">
                        @item.Nom_Vol
                    </td>

                    <!-- TRAJET -->
                    <td>
                        <div class="d-flex flex-column">
                            <span class="fw-semibold">@item.Lieu_Depart</span>
                            <small class="text-muted">→ @item.Lieu_Arriver</small>
                        </div>
                    </td>

                    <!-- HORAIRES -->
                    <td>
                        <div class="d-flex flex-column small">
                            <span>🕒 @item.Heur_Depart</span>
                            <span class="text-muted">
                                @item.Date_Depart.ToString("dd MMM yyyy")
                            </span>
                        </div>
                    </td>

                    <!-- DUREE -->
                    <td>
                        <span class="badge bg-secondary-subtle text-dark">
                            ⏱ @item.Duree
                        </span>
                    </td>

                    <!-- PRIX -->
                    <td>
                        <span class="badge bg-success-subtle text-success fw-semibold">
                            @item.Prix $
                        </span>
                    </td>

                    <!-- ACTIONS -->
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-light btn-sm border">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a class="btn btn-light btn-sm border text-success"
                               asp-controller="Billets"
                               asp-action="Create"
                               asp-route-idDestination="@item.Id"
                               asp-route-prixBillet="@item.Prix">
                                <i class="bi bi-ticket"></i>
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-light btn-sm border text-danger">
                                <i class="bi bi-trash"></i>
                            </a>

                        </div>
                    </td>

                </tr>
            }
        </tbody>
    </table>

</div>

</div>

<style>
tbody tr {
    transition: 0.2s ease;
}

tbody tr:hover {
    background-color: #f8f9fa;
    transform: scale(1.005);
}
</style>
