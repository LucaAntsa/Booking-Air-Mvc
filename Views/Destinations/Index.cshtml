@model List<Booking_Mvc.Models.Destination>

@{
    ViewData["Title"] = "Destinations";
    Layout = "~/Views/Shared/DashboardLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Liste des destinations</h2>
        <a asp-action="Create" class="btn btn-success">Nouvelle destination</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Départ</th>
                <th>Arrivée</th>
                <th>Heure départ</th>
                <th>Durée</th>
                <th>Date départ</th>
                <th>Date arrivée</th>
                <th>Prix</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Lieu_Depart</td>
                <td>@item.Lieu_Depart</td>
                <td>@item.Heur_Depart</td>
                <td>@item.Duree</td>
                <td>@item.Date_Depart</td>
                <td>@item.Date_Arriver</td>
                <td>@item.Prix$</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Modifier</a>
                    <a class="btn btn-primary btn-sm" asp-controller="Billets" asp-action="Create" asp-route-idDestination="@item.Id" asp-route-prixBillet="@item.Prix" asp-area="">Create billets</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Supprimer</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>